# Shared Upstash (or any) Redis URL -- MUST be the same value used by the
# worker and by every backend node (Render + Railway).
REDIS_URL=redis://localhost:6379/0

# Which deployed instance this is. Set to "render" on Render and
# "railway" on Railway; leave as "local" for local dev.
NODE_NAME=local

# Comma-separated list of allowed frontend origins, or "*" for any.
ALLOWED_ORIGINS=*

# How long job state is kept in Redis after last update (seconds).
JOB_TTL_SECONDS=86400
